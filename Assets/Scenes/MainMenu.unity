  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Explore thoroughly \u2014 important items may be hidden inside drawers,
    cabinets, or tucked away in dark corners.\n\nRead notes and journals carefully
    \u2014 many puzzles rely on clues found in documents scattered across the mansion.\n\nKeep
    track of locked doors \u2014 many areas are initially inaccessible but will open
    after puzzle completion or item collection.\n\nWatch for visual and audio clues
    \u2014 some events only trigger after observing certain objects or entering specific
    rooms.\n\nNot everything is visible at first \u2014 as you progress, some new
    paths and objects may appear after specific triggers.\n\nInventory management
    matters \u2014 although you won't run out of space, knowing what you\u2019ve
    picked up helps avoid backtracking."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 23a2e4951b27c634f8ab472943900536, type: 2}
